{
  "name": "kuttab-imam-al-ghazali-psb",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi Penerimaan Santri Baru (PSB) Kuttab Imam Al-Ghazali",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "seed:demo": "node server/seed.js --demo",
    "schema": "node scripts/gen-schema.js",
    "reset": "rm -rf data && npm run seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "^2.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.8"
  }
}
